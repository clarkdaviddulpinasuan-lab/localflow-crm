# Vitest runs in demo mode so service tests exercise the deterministic
# localStorage demo store instead of the live Supabase project.
# Vite merges env files: keys present in .env retain their values in test mode.
VITE_DEMO_MODE=true
# Placeholders keep src/lib/supabase.ts happy on CI where .env is absent.
VITE_SUPABASE_URL=https://placeholder.supabase.co
VITE_SUPABASE_ANON_KEY=ci-placeholder-anon-key
VITE_APP_NAME=LocalFlow CRM