# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Application
VITE_APP_NAME=LocalFlow CRM

# Messaging: 'resend' when you have configured the send-message Edge Function,
# 'dryrun' to record sends without actually emailing anyone.
VITE_MESSAGE_PROVIDER=dryrun
